# Copy to repo root — docker compose reads ./.env for variable substitution
# cp .env.docker.example .env
# Or reuse local API env: cp apps/api/.env .env

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
JWT_SECRET=

# Public URLs (browser / OAuth callbacks)
CORS_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000
NEXT_PUBLIC_THP_API_URL=http://localhost:3001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=http://localhost:3001/auth/meta/callback

AUTH_ALLOWLIST=
RUN_MIGRATIONS=true

RESEND_API_KEY=
INTAKE_NOTIFY_EMAIL=
INTAKE_NOTIFY_FROM=THP Intake <notifications@yourdomain.com>

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Access console (/thp) — BFF on web, API on hosted Access
HP_ACCESS_URL=http://127.0.0.1:4001
NEXT_PUBLIC_HP_PUBLIC_KEY=
HP_SECRET_KEY=
HP_TENANT_SLUG=hardport
