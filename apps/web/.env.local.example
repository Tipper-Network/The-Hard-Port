# Copy to apps/web/.env.local — local Next dev (:3000)
# After platform bootstrap, paste pk/sk here.

HP_ACCESS_URL=http://127.0.0.1:4001
HP_TENANT_SLUG=hardport
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_HP_PUBLIC_KEY=pk_replace_after_bootstrap
HP_SECRET_KEY=sk_replace_after_bootstrap

# S3 uploads for /thp/content (BFF presign; public CDN URLs in body_ref)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HP_S3_BUCKET=
HP_S3_REGION=us-east-1
HP_S3_PUBLIC_BASE_URL=https://your-cdn.example.com
HP_S3_PREFIX=content

# Existing website / intake (keep your real values)
# NEXT_PUBLIC_THP_API_URL=http://localhost:3001
