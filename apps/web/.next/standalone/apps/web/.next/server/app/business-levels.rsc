15:["$","article","level-2",{"id":"level-2","className":"border border-secondary/15 bg-depth-10 p-8 lg:p-10","style":{"scrollMarginTop":"5rem"},"children":[["$","div",null,{"className":"flex flex-wrap items-baseline gap-3","children":[["$","span",null,{"className":"font-heading text-4xl text-accent/80","children":"2"}],["$","div",null,{"children":[["$","h2",null,{"className":"font-heading text-2xl font-normal uppercase text-secondary md:text-3xl","children":"Stable and Preparing for Growth"}],["$","p",null,{"className":"mt-1 font-mono text-xs text-secondary/40","children":"level_02_stable_preparing_for_growth"}]]}]]}],["$","p",null,{"className":"mt-4 text-xs font-semibold tracking-wide text-accent uppercase","children":"Defined; destination after Level 1 stability work."}],["$","p",null,{"className":"mt-6 text-base leading-7 text-secondary/75","children":"A Level 2 business has moved beyond immediate survival by establishing a sufficiently clear offer, identifiable core customers, repeatable delivery, financial visibility, and an early evidence system. It is not necessarily highly profitable, independent of its founder, or ready to scale. It is stable enough to protect what works, study what remains uncertain, and prepare deliberate growth experiments without placing the entire business at risk."}],["$","blockquote",null,{"className":"mt-6 border-l-2 border-secondary/30 pl-4 text-sm leading-6 text-secondary/70 italic","children":"Does the business understand what must remain stable before it attempts to grow?"}],["$","div",null,{"className":"mt-6","children":[["$","p",null,{"className":"text-xs font-bold tracking-[0.18em] text-secondary/45 uppercase","children":"Entry gate"}],["$","ul",null,{"className":"mt-3 space-y-2","children":[["$","li","Demand clarity with recurring evidence on a core offer.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"Demand clarity with recurring evidence on a core offer."]}],["$","li","Customer clarity based on observed behavior and feedback.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"Customer clarity based on observed behavior and feedback."]}],["$","li","Retention or community evidence; identifiable repeat relationships.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"Retention or community evidence; identifiable repeat relationships."]}],["$","li","Financial visibility; survival no longer entirely week-to-week.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"Financial visibility; survival no longer entirely week-to-week."]}],["$","li","Operational consistency; core delivery repeatable.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"Operational consistency; core delivery repeatable."]}],["$","li","Reduced founder reactivity; some knowledge externalized.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"Reduced founder reactivity; some knowledge externalized."]}],["$","li","Evidence system; experiments have stated purposes.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"Evidence system; experiments have stated purposes."]}],["$","li","Identity clarity; customers can begin recognizing what the business stands for.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":["$L21","Identity clarity; customers can begin recognizing what the business stands for."]}]]}]]}],null,"$L22","$L23"]}]
16:["$","article","level-3",{"id":"level-3","className":"border border-secondary/15 bg-depth-10 p-8 lg:p-10","style":{"scrollMarginTop":"5rem"},"children":[["$","div",null,{"className":"flex flex-wrap items-baseline gap-3","children":[["$","span",null,{"className":"font-heading text-4xl text-accent/80","children":"3"}],["$","div",null,{"children":[["$","h2",null,{"className":"font-heading text-2xl font-normal uppercase text-secondary md:text-3xl","children":"Attempting Growth, Growth Model Not Yet Stable"}],["$","p",null,{"className":"mt-1 font-mono text-xs text-secondary/40","children":"level_03_attempting_growth"}]]}]]}],["$","p",null,{"className":"mt-4 text-xs font-semibold tracking-wide text-accent uppercase","children":"Defined; next boundary after stability. Not THP's active operational scope yet."}],["$","p",null,{"className":"mt-6 text-base leading-7 text-secondary/75","children":"A Level 3 business has established the Level 2 operating foundation and is actively conducting deliberate experiments intended to increase demand, customers, participation, revenue, capacity, partnerships, or market reach. Its core business remains viable, but its growth mechanism is not yet proven to be repeatable, financially responsible, operationally supportable, or compatible with the business's identity and community."}],["$","blockquote",null,{"className":"mt-6 border-l-2 border-secondary/30 pl-4 text-sm leading-6 text-secondary/70 italic","children":"Can the business produce growth repeatedly without destabilizing the value, relationships, operations, and identity responsible for its existing stability?"}],["$","div",null,{"className":"mt-6","children":[["$","p",null,{"className":"text-xs font-bold tracking-[0.18em] text-secondary/45 uppercase","children":"Entry gate"}],["$","ul",null,{"className":"mt-3 space-y-2","children":[["$","li","The Level 2 foundation remains active.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"The Level 2 foundation remains active."]}],["$","li","A specific growth objective and growth constraint are defined.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"A specific growth objective and growth constraint are defined."]}],["$","li","A deliberate experiment is active; resources are committed, not merely planned.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"A deliberate experiment is active; resources are committed, not merely planned."]}],["$","li","The viable core is protected with stop conditions.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"The viable core is protected with stop conditions."]}],["$","li","Baseline evidence exists so results can be compared.",{"className":"flex gap-2 text-sm leading-6 text-secondary/70","children":[["$","span",null,{"className":"font-bold text-accent","children":"·"}],"Baseline evidence exists so results can be compared."]}]]}]]}],null,["$","div",null,{"className":"mt-6","children":[["$","p",null,{"className":"text-xs font-bold tracking-[0.18em] text-secondary/45 uppercase","children":"Primary risk"}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-secondary/70","children":"Confusing activity with growth: more customers, revenue, posts, or workload without a proven, repeatable growth mechanism; destabilizing the viable core in pursuit of momentum."}]]}],["$","p",null,{"className":"mt-6 border-l-2 border-accent/60 pl-4 text-sm leading-6 text-secondary/65","children":"At Level 1, instability concerns the viability of the core business. At Level 3, instability concerns the growth mechanism. A business may regress to Level 2 when an experiment ends and the foundation remains intact."}]]}]
