22:["$","div",null,{"className":"mt-6","children":[["$","p",null,{"className":"text-xs font-bold tracking-[0.18em] text-secondary/45 uppercase","children":"Primary risk"}],["$","p",null,{"className":"mt-3 text-sm leading-6 text-secondary/70","children":"Premature growth: interpreting early stability as proof of readiness for aggressive expansion before the foundation is protected and baselined."}]]}]
23:["$","p",null,{"className":"mt-6 border-l-2 border-accent/60 pl-4 text-sm leading-6 text-secondary/65","children":"Stability must be demonstrated across at least three complete business cycles and, for frequent-transaction businesses, across approximately ninety days. A temporary spike cannot be used as evidence of progression."}]
