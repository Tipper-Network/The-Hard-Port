# Copy to .env.local — overrides apps/api/.env for local machine

# Option A — SSH tunnel to Dokploy (run scripts/db-tunnel.sh first)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_URL_ENCODED@127.0.0.1:5432/THP

# Option B — Dokploy external/public host (same host you use in DBeaver)
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_URL_ENCODED@YOUR_SERVER_IP:5432/THP

# Password tip: encode @ as %40 in the URL
