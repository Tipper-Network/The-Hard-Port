{
  "name": "the-hard-port",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:kill": "fuser -k 3000/tcp 3001/tcp 4001/tcp 2>/dev/null || true",
    "dev:console": "pnpm --filter web dev",
    "dev:all": "pnpm --parallel --filter web --filter api dev",
    "platform:secrets:local": "tsx scripts/local/generate-platform-secrets.ts",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "start": "pnpm --filter web start",
    "start:api": "pnpm --filter api start:prod",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter api prisma:migrate:deploy",
    "db:studio": "pnpm --filter api prisma:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "platform:typecheck": "tsc --noEmit -p tsconfig.platform.json",
    "platform:test": "node --import tsx --test --test-concurrency=1 packages/core/test/*.test.ts services/payments/test/*.test.ts",
    "platform:migrate": "tsx scripts/platform/migrate.ts",
    "platform:bootstrap": "tsx scripts/platform/bootstrap.ts",
    "platform:seed:dev-user": "tsx scripts/local/seed-thp-dev-user.ts"
  },
  "devDependencies": {
    "@hardport/core": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp"
    ],
    "overrides": {
      "next": "15.5.29"
    }
  }
}
