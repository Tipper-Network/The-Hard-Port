{
  "name": "the-hard-port",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm --filter web build && pnpm --filter api build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "start": "pnpm --filter web start",
    "start:api": "pnpm --filter api start:prod",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate",
    "db:migrate:deploy": "pnpm --filter api prisma:migrate:deploy",
    "db:studio": "pnpm --filter api prisma:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "platform:typecheck": "tsc --noEmit -p tsconfig.platform.json",
    "platform:test": "node --import tsx --test --test-concurrency=1 packages/core/test/*.test.ts services/access/test/*.test.ts services/payments/test/*.test.ts",
    "platform:migrate": "tsx scripts/platform/migrate.ts",
    "platform:bootstrap": "tsx scripts/platform/bootstrap.ts"
  },
  "devDependencies": {
    "@hardport/core": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
